OPENAI_API_KEY=sk-proj-
# Required when LLM_PROVIDER=openrouter (keys start with "sk-or-")
OPENROUTER_API_KEY=
LANGSMITH_API_KEY=lsv2_pt_
EXA_API_KEY=
TAVILY_API_KEY=tvly-dev-
# doc-rag-backend / api.ragtogo.com corpus search; optional, needed for the corpus route
RAG_API_KEY=

# Optional for local development
DATABASE_URI=
# The reason we're using two variables is to maintain compatibility with existing setups, since langgraph overrides the REDIS_URI variable.
REDIS_URI=redis://localhost:6379
REDIS_URL=redis://localhost:6379